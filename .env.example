# Festival Postgres, read-only. The festival site's DATABASE_URL works here,
# including its transaction-pooler URI (port 6543). This app reads tickets in
# session mode on that same pooler and sets the session read-only.
# A direct db.<ref>.supabase.co host is IPv6-only. It is rewritten to the
# festival IPv4 session pooler (aws-1-us-east-1 by default). If that cluster
# does not have the project, the other us-east-1 prefix is tried.
# Paste one URL. The database name is postgres.
# FESTIVAL_SUPABASE_POOLER_HOST=aws-1-us-east-1.pooler.supabase.com
FESTIVAL_DATABASE_URL=

# This app's own Postgres. Snapshot rows and card setup are written here.
# Never the festival database. The direct db.<project>.supabase.co host is
# IPv6-only and times out on Vercel; the app rewrites that host to the
# IPv4 session pooler. A session pooler URI (port 5432) also works as-is.
DASHBOARD_DATABASE_URL=

# Square POS (not the website checkout location).
SQUARE_ACCESS_TOKEN=
SQUARE_ENVIRONMENT=production

# Browser gate for the TV / office screen.
DASHBOARD_BASIC_AUTH_USER=
DASHBOARD_BASIC_AUTH_PASSWORD=

# Vercel sends this as Authorization: Bearer <CRON_SECRET> on cron invocations.
CRON_SECRET=

# Dev only. Ignored when NODE_ENV or VERCEL_ENV is production.
# DASHBOARD_SAMPLE=1
